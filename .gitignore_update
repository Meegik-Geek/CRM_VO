# === GITIGNORE ДЛЯ ОНОВЛЕННЯ (Binary Distribution) ===
# Цей файл має бути в папці з зібраною програмою (build/...)
# Він дозволяє лише EXE, DLL та ресурси, ігноруючи вихідний код.

# Ігноруємо абсолютно все спочатку
*

# Дозволяємо лише необхідні типи файлів
!*.exe
!*.dll
!*.txt
!*.ico
!*.pyd
!*.zip

# Дозволяємо папки з ресурсами та бібліотеками
!lib/
!resource/
!templates/
!pages/
!reports/
!db/
!implement/
!utils/

# --- ВИНЯТКИ (Що НЕ МОЖНА включати в оновлення) ---
# Ніколи не передаємо файли налаштувань, щоб не стерти базу клієнта!
.env
host.txt
backup_log.txt
CRM_Backups/

# Ігноруємо весь вихідний код (на всяк випадок, якщо він там є)
*.py
*.pyc
__pycache__/
