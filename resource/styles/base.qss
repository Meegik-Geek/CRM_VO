/* === БАЗОВА СТРУКТУРА (Без кольорів) === */

QMainWindow {
    font-family: Inter, Arial, sans-serif;
    padding: 10px;
}

QDialog {
    font-family: Inter, Arial, sans-serif;
    border-radius: 8px;
}

QWidget {
    background-color: transparent;
    outline: none;
}

QScrollArea, QFrame {
    border: none;
    background-color: transparent;
    padding: 0px;
    margin: 0px;
}

QScrollArea > QWidget > QWidget {
    padding: 0px;
    margin: 0px;
}

QScrollArea #formContainer {
    padding: 0px;
    margin: 0px;
}

QLabel {
    font-weight: 400;
    margin-top: 2px; /* Додано відступ для написів */
}

QLabel#titleLabel {
    font-weight: 600;
}

QLabel#adminTitleLabel {
    font-weight: 600;
}

QLabel#generalDescLabel {
    font-style: italic;
    font-size: 16px;
}

QLabel#reportDescription {
    font-size: 15px;
    line-height: 1.5;
    margin-bottom: 10px;
    padding: 5px;
}

QPushButton {
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 400;
}

QPushButton#iconButton {
    border: none;
    padding: 4px;
}

QPushButton#logButton, QPushButton#mainButton, QPushButton#previewButton {
    border: none;
    border-radius: 4px;
    padding: 6px;
    font-weight: 400;
}

QLineEdit, QAbstractSpinBox, QTimeEdit, QDateEdit, QDateTimeEdit {
    border-style: solid;
    border-width: 1px;
    border-radius: 6px;
    padding: 5px;
    margin-bottom: 2px;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 20px;
}

QAbstractSpinBox::up-arrow, QAbstractSpinBox::down-arrow {
    width: 6px;
    height: 6px;
    border-style: solid;
    border-color: #333;
}

QAbstractSpinBox::up-arrow {
    border-width: 2px 2px 0 0;
    margin-top: 3px;
}

QAbstractSpinBox::down-arrow {
    border-width: 0 0 2px 2px;
    margin-bottom: 3px;
}

QComboBox {
    border-style: solid;
    border-width: 1px;
    border-radius: 6px;
    padding: 4px 8px;
    margin-bottom: 2px;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    margin-right: 4px;
}

QComboBox::down-arrow {
    width: 7px;
    height: 7px;
    border-style: solid;
    border-width: 0 2px 2px 0;
    border-color: #333;
    margin: 0 6px 0 0;
}

QComboBox QAbstractItemView {
    border-style: solid;
    border-width: 1px;
    border-radius: 6px;
    outline: 0;
}

QTextEdit {
    border-style: solid;
    border-width: 1px;
    border-radius: 6px;
    padding: 8px;
    margin-bottom: 2px;
}

QComboBox[placeholder-text] {
    font-style: italic;
}

QListWidget {
    border: none;
    border-radius: 4px;
}

QListWidget::item {
    border: none;
    padding: 12px 16px;
}

QListWidget::item:selected {
    border-right-style: solid;
    border-right-width: 4px;
    font-weight: 500;
}

QListWidget::item[role="section"] {
    font-weight: 600;
    padding: 10px;
    border: none;
    text-transform: uppercase;
}

QTableWidget { 
    border-style: solid;
    border-width: 1px;
    border-radius: 6px;
    outline: 0;
}

QTableWidget::item {
    padding: 8px 5px;
}

QHeaderView::section { 
    padding: 10px; 
    border: none; 
    font-weight: 600;
}

QHeaderView::section:horizontal {
    border-bottom-style: solid;
    border-bottom-width: 1px;
}

QTableWidget::item {
    padding: 0px;
    margin: 0px;
}

QHeaderView::section:vertical {
    border-right-style: solid;
    border-right-width: 1px;
}

QTableCornerButton::section {
    border: none;
}

QTableWidget QLineEdit {
    border: 1px solid #3498db;
    margin: -2px;
    padding: 0px 5px;
    background-color: #ffffff;
    border-radius: 0px;
}

QTableWidget QPushButton {
    border-radius: 12px;
    padding: 2px 10px;
}

/* Специфічні стилі для таблиці користувачів */
#usersTable QLineEdit {
    border: 1px solid #d1d5db;
    margin: 5px;
    border-radius: 6px;
    background-color: #ffffff;
    min-height: 30px;
}

#usersTable QPushButton {
    margin: 5px 10px;
    border-radius: 15px;
    height: 32px;
}

QTableWidget::indicator {
    width: 20px;
    height: 20px;
}

QTableWidget::indicator:unchecked {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
}

QTableWidget::indicator:checked {
    background-color: #3498db;
    border: 1px solid #2980b9;
    border-radius: 4px;
    image: url(resource/icons/check_white.png);
}

QTableWidget QComboBox {
    border: 1px solid #3498db;
    margin: -2px;
    padding: 0px 5px;
    background-color: #ffffff;
    border-radius: 0px;
}

/* Скролбари - структура та кольори за замовчуванням */
QScrollBar:vertical { 
    border: none; 
    width: 10px; 
    margin: 0px;
    background: #f1f1f1;
}

QScrollBar::handle:vertical { 
    border-radius: 5px; 
    min-height: 30px; 
    background: #ccc;
}

QScrollBar::handle:vertical:hover {
    background: #999;
}

QScrollBar:horizontal { 
    border: none; 
    height: 10px; 
    margin: 0px;
    background: #f1f1f1;
}

QScrollBar::handle:horizontal { 
    border-radius: 5px; 
    min-width: 30px; 
    background: #ccc;
}

QScrollBar::handle:horizontal:hover {
    background: #999;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QSplitter::handle {
    width: 6px;
}

QMenu#contextMenu {
    border-style: solid;
    border-width: 1px;
    padding: 2px;
}

QMenu#contextMenu::item {
    padding: 6px 12px;
}

QMenu#contextMenu::separator {
    height: 1px;
    margin: 2px 0;
}

QGroupBox#groupBox {
    border-style: solid;
    border-width: 1px;
    margin: 10px 0px 5px 0px;
    padding: 10px;
    border-radius: 8px;
}

QGroupBox#groupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: 5px; /* Вирівнювання по центру лінії */
    padding: 0 5px;
}

QCheckBox {
    spacing: 8px;
    font-weight: 400;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border-style: solid;
    border-width: 1px;
}