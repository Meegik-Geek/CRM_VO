/* === СВІТЛА ТЕМА (Тільки кольори) === */

QMainWindow {
    background-color: #F5F7FA;
    border: none;
}

QDialog, QWidget#rightPanel {
    background-color: #FFFFFF;
}

QLabel {
    color: #1E1E1E;
}

QLabel#errorLabel {
    color: #E53935;
}

/* Кнопки */
QPushButton {
    background-color: #E0E0E0;
    color: #1E1E1E;
}

QPushButton:hover {
    background-color: #D5D5D5;
}

QPushButton:disabled,
QPushButton#greenButton:disabled,
QPushButton#loginButton:disabled,
QPushButton#printButton:disabled,
QPushButton#editButton:disabled,
QPushButton#cancelButton:disabled,
QPushButton#clearButton:disabled,
QPushButton#errorButton:disabled,
QPushButton#drukButton:disabled,
QPushButton#navButton:disabled,
QPushButton#searchButton:disabled {
    background-color: #F0F0F0;
    color: #BDBDBD;
}

QPushButton#navButton, QPushButton#searchButton, QPushButton#logButton, 
QPushButton#mainButton, QPushButton#previewButton {
    background-color: #2979FF;
    color: #FFFFFF;
}

QPushButton#navButton:hover {
    background-color: #1976D2;
}

QPushButton#greenButton, QPushButton#loginButton, QPushButton#printButton {
    background-color: #4CAF50;
    color: #FFFFFF;
}

QPushButton#clearButton, QPushButton#errorButton {
    background-color: #E53935;
    color: #FFFFFF;
}

QPushButton#editButton {
    background-color: #F59E0B;
    color: #FFFFFF;
}

QPushButton#editButton:hover {
    background-color: #D97706;
}

QPushButton#cancelButton {
    background-color: #FF9999;
    color: #FFFFFF;
}

QPushButton#drukButton {
    background-color: #E3F2FD;
    color: #1E1E1E;
}

/* Поля вводу */
QLineEdit, QComboBox, QTextEdit {
    background-color: #FFFFFF;
    color: #1E1E1E;
    border-color: #B0BEC5;
    selection-background-color: #E3F2FD;
    selection-color: #1E1E1E;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border-color: #2979FF;
}

QComboBox::down-arrow {
    border-color: #757575;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1E1E1E;
    border-color: #2979FF;
    selection-background-color: #E3F2FD;
    selection-color: #1E1E1E;
}

/* Списки */
QListWidget {
    background-color: #FFFFFF;
    color: #1E1E1E;
}

QListWidget::item:selected {
    background-color: #2979FF;
    color: #FFFFFF;
    border-right-color: #1565C0;
}

QListWidget::item:hover {
    background-color: #E3F2FD;
    color: #1E1E1E;
}

QListWidget::item[role="section"] {
    color: #475569;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #1E1E1E;
    gridline-color: #ECEFF1;
    border-color: #CFD8DC;
    selection-background-color: #E3F2FD;
    selection-color: #1E1E1E;
}

QTableWidget::item:selected {
    background-color: #E3F2FD;
    color: #1E1E1E;
}

QHeaderView::section {
    background-color: #F5F7FA;
    color: #606770;
    border-bottom-color: #CFD8DC;
    border-right-color: #CFD8DC;
}

QTableCornerButton::section {
    background-color: #F5F7FA;
}

/* Скролбари */
QScrollBar:vertical, QScrollBar:horizontal {
    background: rgba(245, 247, 2FA, 0.5);
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #CFD8DC;
    margin: 2px;
}

QScrollBar::handle:hover {
    background: #B0BEC5;
}

QScrollBar::handle:pressed {
    background: #2979FF;
}

/* Меню */
QMenu#contextMenu {
    background-color: #FFFFFF;
    color: #1E1E1E;
    border-color: #B0BEC5;
}

QMenu#contextMenu::item:selected {
    background-color: #E3F2FD;
}

QMenu#contextMenu::separator {
    background-color: #B0BEC5;
}

QGroupBox#groupBox {
    border-color: #B0BEC5;
    border-radius: 8px;
}

QGroupBox#groupBox::title {
    color: #94A3B8;
    font-weight: 600;
}

QCheckBox {
    color: #1E1E1E;
}

QCheckBox::indicator {
    background-color: #FFFFFF;
    border-color: #B0BEC5;
}

QCheckBox::indicator:hover {
    border-color: #2979FF;
}

QCheckBox::indicator:checked {
    background-color: #2979FF;
    border-color: #1565C0;
    image: url(resource/icons/check_white.png);
}

QCheckBox::indicator:disabled {
    background-color: #F5F7FA;
    border-color: #D5D5D5;
}

QLabel#generalDescLabel, QLabel#reportDescription {
    color: #64748B;
}